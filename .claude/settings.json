{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/autofix-guard.mjs\" || { [ \"$GQ_AUTOFIX\" = \"1\" ] && exit 2; exit 0; }"
          }
        ]
      }
    ]
  }
}
